{
  "name": "banwonpoker",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @banwonpoker/web dev",
    "dev:server": "pnpm --filter @banwonpoker/server dev",
    "start:server": "pnpm --filter @banwonpoker/server start",
    "build": "pnpm --filter @banwonpoker/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @banwonpoker/web test:e2e",
    "test:e2e:update": "pnpm --filter @banwonpoker/web test:e2e:update"
  }
}
